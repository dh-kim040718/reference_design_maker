{
  "manifest_version": 3,
  "name": "레퍼런스 메이커에 저장",
  "description": "현재 페이지의 링크와 제목을 레퍼런스 메이커로 전달합니다. 저장 전 분류와 내용을 확인할 수 있습니다.",
  "version": "0.1.1",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["activeTab", "storage"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "이 페이지를 레퍼런스 메이커에 저장", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
